{
  "build": {
    "content": [
      {
        "files": [ "toc.yml", "**.md", "**/toc.yml" ],
        "exclude": [ "docs/**/*.*" ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "**.svg",
          "**.png",
          "llms.txt",
          "**/samples/**/*.js",
          "**/samples/**/*.html",
          "**/samples/**/*.css"
        ],
        "exclude": [ "docs/**/*.*", "logo.svg" ]
      },
      {
        "files": [ "logo.svg", "favicon.ico" ],
        "dest": "images/branding"
      },
      {
        "files": [ "**.md" ],
        "exclude": [ "docs/**/*.*" ],
        "group": "markdown-source"
      }
    ],
    "xref": [
      "https://erpnetdocs.github.io/model/xrefmap.yml",
      "https://erpnetdocs.github.io/tech/xrefmap.yml"
    ],    
    "dest": "docs",
    "globalMetadata": {
      "_appTitle": "ERP.net Developer Docs",
      "_enableSearch": true,
      "_appLogoPath": "images/branding/logo.svg",
      "_appFaviconPath": "images/branding/favicon.ico",
	  "pdf": false,
	  "_disableToc": false
    },
    "globalMetadataFiles": [],
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern",
      "templates/material",
      "templates/agent-docs"
    ],
    "postProcessors": ["ExtractSearchIndex"],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false
  }
}
